{
  "name": "pughcraft",
  "productName": "Pughcraft",
  "version": "0.2.1",
  "description": "Host a Minecraft: Java Edition server on your own PC in a few clicks.",
  "main": "./out/main/index.js",
  "author": "iPushButtonz",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/iPushButtonz/Pughcraft",
  "repository": {
    "type": "git",
    "url": "https://github.com/iPushButtonz/Pughcraft.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9222 --inspect 9229",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@xmcl/mod-parser": "3.4.2",
    "@xmcl/nbt": "3.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2",
    "@xmcl/mod-parser": "3.4.2",
    "@xmcl/nbt": "3.0.2",
    "@xmcl/system": "2.2.9"
  }
}
